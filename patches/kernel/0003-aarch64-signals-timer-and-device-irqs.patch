+++ b/src/arch/aarch64/device/generic_timer.rs
@@ -30,6 +30,15 @@ struct TimerConfig {
 
 static TIMER: Once<TimerConfig> = Once::new();
 
+// Keep the architected timer period consistent with scheduler accounting.
+// A hard-coded 100 Hz tick stretches the nominal 6.75 ms preemption interval
+// to 30 ms, starving interactive device/IPC chains on a single CPU.
+fn scheduler_reload_count(clk_freq: u32) -> u32 {
+    ((clk_freq as u128 * context::switch::NANOS_PER_TICK / time::NANOS_PER_SEC)
+        .max(1)) as u32
+}
+
+
 pub(crate) fn ready() -> bool {
     TIMER.get().is_some()
 }
