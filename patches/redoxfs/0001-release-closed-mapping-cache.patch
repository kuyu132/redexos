+    #[cfg(target_os = "redox")]
+    {
+        // Early static ARM64 services cannot use env_logger's TLS buffer.
+        struct BootLogger;
+        impl log::Log for BootLogger {
+            fn enabled(&self, metadata: &log::Metadata<'_>) -> bool {
+                metadata.level() <= log::Level::Info
+            }
+            fn log(&self, record: &log::Record<'_>) {
+                if self.enabled(record.metadata()) {
+                    eprintln!("redoxfs {}: {}", record.level(), record.args());
+                }
+            }
+            fn flush(&self) {}
+        }
+        static LOGGER: BootLogger = BootLogger;
+        log::set_logger(&LOGGER).expect("redoxfs logger");
+        log::set_max_level(log::LevelFilter::Info);
+    }
