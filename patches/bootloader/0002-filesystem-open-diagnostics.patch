+/// Observe firmware state without changing its exception or memory settings.
+pub fn print_boot_cpu_state() {
+    let (el, sp, control, fp): (u64, u64, u64, u64);
+    unsafe {
+        asm!("mrs {}, CurrentEL", out(reg) el, options(nomem, nostack));
+        asm!("mov {}, sp", out(reg) sp, options(nomem, nostack));
+        if el == 8 {
+            asm!("mrs {}, SCTLR_EL2", out(reg) control, options(nomem, nostack));
+            asm!("mrs {}, CPTR_EL2", out(reg) fp, options(nomem, nostack));
+        } else if el == 4 {
+            asm!("mrs {}, SCTLR_EL1", out(reg) control, options(nomem, nostack));
+            asm!("mrs {}, CPACR_EL1", out(reg) fp, options(nomem, nostack));
+        } else {
+            println!("[FS-CPU] Unexpected EL{} sp={:#x}", el >> 2, sp);
+            return;
+        }
+    }
+    println!("[FS-CPU] EL{} sp={:#x} sctlr={:#x} align_check={}",
+        el >> 2, sp, control, (control >> 1) & 1);
+    println!("[FS-CPU] {}={:#x}", if el == 8 { "cptr_el2" } else { "cpacr_el1" }, fp);
+}
