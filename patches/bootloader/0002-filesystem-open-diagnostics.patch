new file mode 100644
index 0000000..0fb7b5a
--- /dev/null
+++ b/src/fs_trace.rs
@@ -0,0 +1,75 @@
+//! Memory-disk bounds and scoped tracing used while opening RedoxFS.
+
+pub fn checked_file_read(
+    data: &[u8],
+    block: u64,
+    block_size: u64,
+    out: &mut [u8],
+) -> Option<usize> {
+    let start = usize::try_from(block.checked_mul(block_size)?).ok()?;
+    let end = start.checked_add(out.len())?;
+    out.copy_from_slice(data.get(start..end)?);
+    Some(out.len())
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum ReadEvent {
+    Pending {
+        sequence: u64,
+        block: u64,
+        length: usize,
+    },
+    Returned {
+        sequence: u64,
+        count: usize,
+    },
+    Failed {
+        sequence: u64,
+    },
+}
+
+#[derive(Default)]
+pub struct ReadTrace {
+    enabled: bool,
+    count: u64,
+}
+
+impl ReadTrace {
+    pub fn start(&mut self) {
+        self.enabled = true;
+        self.count = 0;
+    }
+
+    pub fn stop(&mut self) -> u64 {
+        self.enabled = false;
+        self.count
+    }
+
+    pub fn read<E>(
+        &mut self,
+        block: u64,
+        length: usize,
+        read: impl FnOnce() -> Result<usize, E>,
+        mut emit: impl FnMut(ReadEvent),
+    ) -> Result<usize, E> {
+        if !self.enabled {
+            return read();
+        }
+        self.count += 1;
+        let sequence = self.count;
+        emit(ReadEvent::Pending {
+            sequence,
+            block,
+            length,
+        });
+        let result = read();
+        emit(match &result {
+            Ok(count) => ReadEvent::Returned {
+                sequence,
+                count: *count,
+            },
+            Err(_) => ReadEvent::Failed { sequence },
+        });
+        result
+    }
+}
diff --git a/src/live_read.rs b/src/live_read.rs
new file mode 100644
index 0000000..ed62fc1
--- /dev/null
+++ b/src/live_read.rs
@@ -0,0 +1,79 @@
+//! Bounded firmware reads with progress emitted BEFORE every potentially blocking call.
+use alloc::vec::Vec;
+
+pub const READ_CHUNK: usize = 1024 * 1024;
+
+#[derive(Debug)]
+pub enum ReadError<E> {
+    Allocation {
+        size: usize,
+    },
+    Firmware {
+        offset: usize,
+        status: E,
+    },
+    UnexpectedEof {
+        offset: usize,
+        expected: usize,
+    },
+    InvalidCount {
+        offset: usize,
+        count: usize,
+        requested: usize,
+    },
+}
+
+#[derive(Debug)]
+pub enum ReadProgress {
+    Allocating {
+        size: usize,
+    },
+    Reading {
+        offset: usize,
+        total: usize,
+        requested: usize,
+    },
+    Complete {
+        size: usize,
+    },
+}
+
+pub fn read_image<E>(
+    size: usize,
+    mut read: impl FnMut(&mut [u8]) -> Result<usize, E>,
+    mut progress: impl FnMut(ReadProgress),
+) -> Result<Vec<u8>, ReadError<E>> {
+    progress(ReadProgress::Allocating { size });
+    let mut buffer = Vec::new();
+    buffer
+        .try_reserve_exact(size)
+        .map_err(|_| ReadError::Allocation { size })?;
+    buffer.resize(size, 0);
+    let mut offset = 0;
+    while offset < size {
+        let requested = (size - offset).min(READ_CHUNK);
+        progress(ReadProgress::Reading {
+            offset,
+            total: size,
+            requested,
+        });
+        let count = read(&mut buffer[offset..offset + requested])
+            .map_err(|status| ReadError::Firmware { offset, status })?;
+        if count == 0 {
+            return Err(ReadError::UnexpectedEof {
+                offset,
+                expected: size,
+            });
+        }
+        if count > requested {
+            return Err(ReadError::InvalidCount {
+                offset,
+                count,
+                requested,
+            });
+        }
+        offset += count;
+    }
+    progress(ReadProgress::Complete { size });
+    Ok(buffer)
+}
