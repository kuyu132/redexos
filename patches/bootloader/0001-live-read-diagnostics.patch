index 0000000..ed62fc1
--- /dev/null
+++ b/src/live_read.rs
@@ -0,0 +1,79 @@
+//! Bounded firmware reads with progress emitted BEFORE every potentially blocking call.
+use alloc::vec::Vec;
+
+pub const READ_CHUNK: usize = 1024 * 1024;
+
+#[derive(Debug)]
+pub enum ReadError<E> {
+    Allocation {
+        size: usize,
+    },
+    Firmware {
+        offset: usize,
+        status: E,
+    },
+    UnexpectedEof {
+        offset: usize,
+        expected: usize,
+    },
+    InvalidCount {
+        offset: usize,
+        count: usize,
+        requested: usize,
+    },
+}
+
+#[derive(Debug)]
+pub enum ReadProgress {
+    Allocating {
+        size: usize,
+    },
+    Reading {
+        offset: usize,
+        total: usize,
+        requested: usize,
+    },
+    Complete {
+        size: usize,
+    },
+}
+
+pub fn read_image<E>(
+    size: usize,
+    mut read: impl FnMut(&mut [u8]) -> Result<usize, E>,
+    mut progress: impl FnMut(ReadProgress),
+) -> Result<Vec<u8>, ReadError<E>> {
+    progress(ReadProgress::Allocating { size });
+    let mut buffer = Vec::new();
+    buffer
+        .try_reserve_exact(size)
+        .map_err(|_| ReadError::Allocation { size })?;
+    buffer.resize(size, 0);
+    let mut offset = 0;
+    while offset < size {
+        let requested = (size - offset).min(READ_CHUNK);
+        progress(ReadProgress::Reading {
+            offset,
+            total: size,
+            requested,
+        });
+        let count = read(&mut buffer[offset..offset + requested])
+            .map_err(|status| ReadError::Firmware { offset, status })?;
+        if count == 0 {
+            return Err(ReadError::UnexpectedEof {
+                offset,
+                expected: size,
+            });
+        }
+        if count > requested {
+            return Err(ReadError::InvalidCount {
+                offset,
+                count,
+                requested,
+            });
+        }
+        offset += count;
+    }
+    progress(ReadProgress::Complete { size });
+    Ok(buffer)
+}
