diff --git a/gdb/inf-ptrace.c b/gdb/inf-ptrace.c
index acb80af9..dc4fe7ff 100644
--- a/gdb/inf-ptrace.c
+++ b/gdb/inf-ptrace.c
@@ -63,7 +63,26 @@ inf_ptrace_me (void)
   /* "Trace me, Dr. Memory!"  */
   if (ptrace (PT_TRACE_ME, 0, (PTRACE_TYPE_ARG3) 0, 0) < 0)
     trace_start_error_with_name ("ptrace");
+#ifdef __redox__
+  raise (SIGSTOP);
+#endif
+}
+
+#ifdef __redox__
+/* Child capabilities are issued by procmgr after the initial child stop. */
+static void
+redox_init_trace (int pid)
+{
+  int status;
+  if (waitpid (pid, &status, WUNTRACED) != pid)
+    perror_with_name ("initial child stop");
+  if (!WIFSTOPPED (status))
+    error ("Child exited before initial child stop (wait status %#x).", status);
+  if (ptrace (PTRACE_ATTACH, pid, (void *) 0, (void *) 0) < 0
+      || ptrace (PTRACE_CONT, pid, (void *) 0, (void *) 0) < 0)
+    perror_with_name ("attach child trace capability");
 }
+#endif
 
 /* Start a new inferior Unix child process.  EXEC_FILE is the file to
    run, ALLARGS is a string containing the arguments to the program.
@@ -92,8 +111,17 @@ inf_ptrace_target::create_inferior (const char *exec_file,
       unpusher.reset (this);
     }
 
-  pid_t pid = fork_inferior (exec_file, allargs, env, inf_ptrace_me, NULL,
-			     NULL, NULL, NULL);
+#ifdef __redox__
+  try
+    {
+#endif
+  pid_t pid = fork_inferior (exec_file, allargs, env, inf_ptrace_me,
+#ifdef __redox__
+                             redox_init_trace,
+#else
+                             NULL,
+#endif
+                             NULL, NULL, NULL);
 
   ptid_t ptid (pid);
   /* We have something that executes now.  We'll be running through
@@ -109,6 +137,24 @@ inf_ptrace_target::create_inferior (const char *exec_file,
   /* On some targets, there must be some explicit actions taken after
      the inferior has been started up.  */
   post_startup_inferior (ptid);
+#ifdef __redox__
+    }
+  catch (const gdb_exception_error &)
+    {
+      // fork_inferior may throw after postfork_hook recorded the PID but
+      // before returning it. Retire that inferior before unpushing its
+      // target, so run's resume guard cannot dereference a missing target.
+      if (inf->pid > 0)
+        {
+          int status;
+          ::kill (inf->pid, SIGKILL);
+          while (waitpid (inf->pid, &status, 0) < 0 && errno == EINTR)
+            ;
+          exit_inferior (inf);
+        }
+      throw;
+    }
+#endif
 }
 
