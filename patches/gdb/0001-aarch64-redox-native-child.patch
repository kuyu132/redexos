diff --git a/gdbsupport/enum-flags.h b/gdbsupport/enum-flags.h
index 50780043..2f8bf81b 100644
--- a/gdbsupport/enum-flags.h
+++ b/gdbsupport/enum-flags.h
@@ -88,13 +88,19 @@ template<> struct integer_for_size<2, 1> { typedef int16_t type; };
 template<> struct integer_for_size<4, 1> { typedef int32_t type; };
 template<> struct integer_for_size<8, 1> { typedef int64_t type; };
 
+/* Use integral promotion without creating an out-of-range enum constant. */
+template<typename T, bool = std::is_convertible<T, int>::value>
+struct enum_promoted_type { using type = typename std::underlying_type<T>::type; };
+template<typename T>
+struct enum_promoted_type<T, true> { using type = decltype (+T {}); };
+
 template<typename T>
 struct enum_underlying_type
 {
   DIAGNOSTIC_PUSH
   DIAGNOSTIC_IGNORE_ENUM_CONSTEXPR_CONVERSION
   typedef typename
-    integer_for_size<sizeof (T), static_cast<bool>(T (-1) < T (0))>::type
+    integer_for_size<sizeof (T), std::is_signed<typename std::conditional<(sizeof (T) < sizeof (int)), typename std::underlying_type<T>::type, typename enum_promoted_type<T>::type>::type>::value>::type
     type;
   DIAGNOSTIC_POP
 };
