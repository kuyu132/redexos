diff --git a/gdb/aarch64-redox-nat.c b/gdb/aarch64-redox-nat.c
new file mode 100644
index 00000000..04c4c5cd
--- /dev/null
+++ b/gdb/aarch64-redox-nat.c
@@ -0,0 +1,66 @@
+/* Native AArch64 Redox child target. SPDX-License-Identifier: GPL-3.0-or-later */
+#include "defs.h"
+#include "inferior.h"
+#include "regcache.h"
+#include "target.h"
+#include "gdbsupport/common-inferior.h"
+#include "inf-ptrace.h"
+#include "aarch64-tdep.h"
+#include "arch/aarch64.h"
+#include <sys/ptrace.h>
+#include <sys/user.h>
+
+class aarch64_redox_nat_target final : public inf_ptrace_target
+{
+public:
+  void fetch_registers (regcache *cache, int regnum) override;
+  void store_registers (regcache *cache, int regnum) override;
+  const target_desc *read_description () override
+  { return aarch64_read_description (aarch64_features {}); }
+protected:
+  void post_startup_inferior (ptid_t) override {}
+};
+
+static aarch64_redox_nat_target redox_target;
+
+void aarch64_redox_nat_target::fetch_registers (regcache *cache, int regnum)
+{
+  user_regs_struct regs;
+  if (ptrace (PTRACE_GETREGS, cache->ptid ().pid (), (void *) 0, &regs) < 0)
+    perror_with_name ("ptrace GETREGS");
+  for (int i = 0; i < gdbarch_num_regs (cache->arch ()); ++i)
+    if (regnum == -1 || regnum == i)
+      {
+        if (i < 31) cache->raw_supply (i, &regs.regs[i]);
+        else if (i == 31) cache->raw_supply (i, &regs.sp);
+        else if (i == 32) cache->raw_supply (i, &regs.pc);
+        else if (i == 33) cache->raw_supply (i, &regs.pstate);
+        else cache->raw_supply (i, nullptr); // SIMD regsets are not implemented yet.
+      }
+}
+
+void aarch64_redox_nat_target::store_registers (regcache *cache, int regnum)
+{
+  if (regnum >= 34) error ("Redox SIMD register writes are not implemented");
+  user_regs_struct regs;
+  if (ptrace (PTRACE_GETREGS, cache->ptid ().pid (), (void *) 0, &regs) < 0)
+    perror_with_name ("ptrace GETREGS");
+  for (int i = 0; i < 34; ++i)
+    if (regnum == -1 || regnum == i)
+      {
+        if (i < 31) cache->raw_collect (i, &regs.regs[i]);
+        else if (i == 31) cache->raw_collect (i, &regs.sp);
+        else if (i == 32) cache->raw_collect (i, &regs.pc);
+        else cache->raw_collect (i, &regs.pstate);
+      }
+  if (ptrace (PTRACE_SETREGS, cache->ptid ().pid (), (void *) 0, &regs) < 0)
+    perror_with_name ("ptrace SETREGS");
+}
+
+void _initialize_aarch64_redox_nat ();
+void
+_initialize_aarch64_redox_nat ()
+{
+  startup_with_shell = false;
+  add_inf_child_target (&redox_target);
+}
