+    /// AArch64 TLS grows upwards after the 16-byte thread-pointer ABI header.
+    /// x86 offsets instead describe the end of a block below the thread pointer.
+    pub fn placement(previous_end: usize, size: usize, align: usize) -> usize {
+        if cfg!(target_arch = "aarch64") {
+            (previous_end + 16).next_multiple_of(align) - 16
+        } else {
+            (previous_end + size).next_multiple_of(align)
+        }
+    }
