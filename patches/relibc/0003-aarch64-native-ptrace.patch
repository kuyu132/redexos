diff --git a/src/platform/redox/ptrace/arm64.rs b/src/platform/redox/ptrace/arm64.rs
new file mode 100644
index 0000000..6e76c23
--- /dev/null
+++ b/src/platform/redox/ptrace/arm64.rs
@@ -0,0 +1,151 @@
+//! ARM64 POSIX ptrace over process-manager child capabilities and kernel trace FDs.
+use super::{Session, init_state};
+use crate::{fs::File, header::{errno::*, fcntl, signal, sys_ptrace::*}, io::{self, Read, Write}, platform::{Pal, PalSignal, Sys, types::*}};
+use alloc::collections::{BTreeMap, btree_map::Entry};
+use core::{mem, ptr, slice};
+
+fn io_error(error: syscall::Error) -> io::Error { io::Error::from_raw_os_error(error.errno) }
+fn duplicate(fd: usize, request: &[u8]) -> io::Result<File> {
+    let fd = redox_rt::sys::dup(fd, request).map_err(io_error)?;
+    let fd = c_int::try_from(fd).map_err(|_| io::Error::from_raw_os_error(EMFILE))?;
+    let file = File::new(fd);
+    Sys::fcntl(fd, fcntl::F_SETFD, fcntl::FD_CLOEXEC as _)?;
+    Ok(file)
+}
+
+pub fn is_traceme(pid: pid_t) -> bool {
+    pid > 0 && duplicate(redox_rt::current_proc_fd().as_raw_fd(), format!("debug-check:{pid}").as_bytes()).is_ok()
+}
+
+pub fn get_session(sessions: &mut BTreeMap<pid_t, Session>, pid: pid_t) -> io::Result<&mut Session> {
+    if pid <= 0 { return Err(io::Error::from_raw_os_error(ESRCH)); }
+    match sessions.entry(pid) {
+        Entry::Occupied(entry) => Ok(entry.into_mut()),
+        Entry::Vacant(entry) => {
+            let thread = duplicate(redox_rt::current_proc_fd().as_raw_fd(), format!("debug-child:{pid}").as_bytes())?;
+            let regs = duplicate(thread.fd as usize, b"regs/debug")?;
+            let tracer = duplicate(thread.fd as usize, b"trace")?;
+            Ok(entry.insert(Session { first: true, thread, regs, tracer }))
+        }
+    }
+}
+
+pub fn has_session(pid: pid_t) -> bool { init_state().sessions.lock().contains_key(&pid) }
+
+pub fn record_wait(pid: pid_t, status: c_int) {
+    let mut sessions = init_state().sessions.lock();
+    if status & 0xff != 0x7f && status != 0xffff {
+        sessions.remove(&pid);
+    } else if status & 0xff == 0x7f && (status >> 8) & 0xff == signal::SIGTRAP as c_int {
+        if let Some(session) = sessions.get(&pid) {
+            // The stop is committed by procmgr only after this event was enqueued.
+            let mut event = syscall::PtraceEvent::default();
+            let bytes = unsafe { slice::from_raw_parts_mut((&mut event as *mut syscall::PtraceEvent).cast::<u8>(), mem::size_of_val(&event)) };
+            let _ = (&session.tracer).read(bytes);
+        }
+    }
+}
+
+fn memory_word(session: &Session, address: usize, replacement: Option<usize>) -> io::Result<c_long> {
+    let space = duplicate(session.thread.fd as usize, b"addrspace")?;
+    let mut result = [0_u8; mem::size_of::<usize>()];
+    let input = replacement.map(usize::to_ne_bytes);
+    let mut copied = 0;
+    while copied < result.len() {
+        let address = address.checked_add(copied).ok_or_else(|| io::Error::from_raw_os_error(EFAULT))?;
+        let page = address & !(syscall::PAGE_SIZE - 1);
+        let displacement = address - page;
+        let count = (result.len() - copied).min(syscall::PAGE_SIZE - displacement);
+        let mut original = syscall::MapFlags::PROT_READ;
+        if input.is_some() {
+            let mut found = false;
+            let mut offset = 0;
+            loop {
+                let mut grants = [syscall::GrantDesc::default(); 32];
+                let bytes = unsafe { slice::from_raw_parts_mut(grants.as_mut_ptr().cast::<u8>(), mem::size_of_val(&grants)) };
+                let size = Sys::pread(space.fd, bytes, offset)?;
+                if size == 0 { break; }
+                for grant in &grants[..size / mem::size_of::<syscall::GrantDesc>()] {
+                    if page >= grant.base && page - grant.base < grant.size {
+                        if grant.flags.contains(syscall::GrantFlags::GRANT_WRITE) { original |= syscall::MapFlags::PROT_WRITE; }
+                        if grant.flags.contains(syscall::GrantFlags::GRANT_EXEC) { original |= syscall::MapFlags::PROT_EXEC; }
+                        found = true; break;
+                    }
+                }
+                if found { break; }
+                offset += size as off_t;
+            }
+            if !found { return Err(io::Error::from_raw_os_error(EFAULT)); }
+            let operation = [syscall::ADDRSPACE_OP_MPROTECT, page, syscall::PAGE_SIZE, (original | syscall::MapFlags::PROT_WRITE).bits()];
+            let bytes = unsafe { slice::from_raw_parts(operation.as_ptr().cast::<u8>(), mem::size_of_val(&operation)) };
+            (&space).write_all(bytes)?;
+        }
+        let transfer = (|| -> io::Result<()> {
+            let flags = syscall::MapFlags::PROT_READ | syscall::MapFlags::MAP_SHARED |
+                if input.is_some() { syscall::MapFlags::PROT_WRITE } else { syscall::MapFlags::empty() };
+            let mapping = unsafe { syscall::fmap(space.fd as usize, &syscall::Map { offset: page, size: syscall::PAGE_SIZE, address: 0, flags }) }.map_err(io_error)?;
+            unsafe {
+                if let Some(input) = &input {
+                    ptr::copy_nonoverlapping(input.as_ptr().add(copied), (mapping as *mut u8).add(displacement), count);
+                } else {
+                    ptr::copy_nonoverlapping((mapping as *const u8).add(displacement), result.as_mut_ptr().add(copied), count);
+                }
+                syscall::funmap(mapping, syscall::PAGE_SIZE).map_err(io_error)?;
+            }
+            Ok(())
+        })();
+        if input.is_some() {
+            let operation = [syscall::ADDRSPACE_OP_MPROTECT, page, syscall::PAGE_SIZE, original.bits()];
+            let bytes = unsafe { slice::from_raw_parts(operation.as_ptr().cast::<u8>(), mem::size_of_val(&operation)) };
+            (&space).write_all(bytes)?;
+        }
+        transfer?;
+        copied += count;
+    }
+    Ok(usize::from_ne_bytes(result) as c_long)
+}
+
+pub unsafe fn inner_ptrace(request: c_int, pid: pid_t, address: *mut c_void, data: *mut c_void) -> io::Result<c_long> {
+    if request == PTRACE_TRACEME {
+        duplicate(redox_rt::current_proc_fd().as_raw_fd(), b"debug-traceme")?;
+        return Ok(0);
+    }
+    let state = init_state();
+    let mut sessions = state.sessions.lock();
+    if request == PTRACE_DETACH || request == PTRACE_KILL {
+        let session = sessions.remove(&pid).ok_or_else(|| io::Error::from_raw_os_error(ESRCH))?;
+        drop(session);
+        Sys::kill(pid, if request == PTRACE_KILL { signal::SIGKILL } else { signal::SIGCONT } as _)?;
+        return Ok(0);
+    }
+    if !matches!(request, PTRACE_ATTACH | PTRACE_CONT | PTRACE_SINGLESTEP | PTRACE_GETREGS | PTRACE_SETREGS | PTRACE_PEEKTEXT | PTRACE_PEEKDATA | PTRACE_POKETEXT | PTRACE_POKEDATA) {
+        return Err(io::Error::from_raw_os_error(EOPNOTSUPP));
+    }
+    let session = get_session(&mut sessions, pid)?;
+    match request {
+        PTRACE_ATTACH => Ok(0),
+        PTRACE_CONT | PTRACE_SINGLESTEP => {
+            let mut flags = syscall::PTRACE_STOP_BREAKPOINT | syscall::PTRACE_EVENT_ADDRSPACE_SWITCH | syscall::PTRACE_STOP_EXIT;
+            if request == PTRACE_SINGLESTEP { flags |= syscall::PTRACE_STOP_SINGLESTEP; }
+            (&session.tracer).write_all(&flags.bits().to_ne_bytes())?;
+            if session.first { Sys::kill(pid, signal::SIGCONT as _)?; session.first = false; }
+            if data as usize != 0 { Sys::kill(pid, data as c_int)?; }
+            Ok(0)
+        }
+        PTRACE_GETREGS | PTRACE_SETREGS => {
+            if data.is_null() { return Err(io::Error::from_raw_os_error(EFAULT)); }
+            let size = mem::size_of::<crate::header::arch_aarch64_user::user_regs_struct>();
+            if request == PTRACE_GETREGS {
+                let output = unsafe { slice::from_raw_parts_mut(data.cast::<u8>(), size) };
+                (&session.regs).read_exact(output)?;
+            } else {
+                let input = unsafe { slice::from_raw_parts(data.cast::<u8>(), size) };
+                (&session.regs).write_all(input)?;
+            }
+            Ok(0)
+        }
+        PTRACE_PEEKTEXT | PTRACE_PEEKDATA => memory_word(session, address as usize, None),
+        PTRACE_POKETEXT | PTRACE_POKEDATA => { memory_word(session, address as usize, Some(data as usize))?; Ok(0) }
+        _ => unreachable!(),
+    }
+}
